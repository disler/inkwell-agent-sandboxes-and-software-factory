# Copy to .env at the repo root and fill in. `.env` is gitignored; never commit it.
#
# This repo runs every model through ONE provider: OpenRouter. One key, one namespace,
# identical model ids on your laptop and inside every sandbox. See CHECKLIST.md.
#
# ─────────────────────────────────────────────────────────────────────────────
# HOST ONLY — never mounted, never enters a sandbox
# ─────────────────────────────────────────────────────────────────────────────
#
# The provisioning key mints and revokes the disposable per-sandbox runtime keys.
# It is the only long-lived secret in the system and the one thing that must never
# reach a VM. Create it at openrouter.ai -> Keys -> Provisioning API Keys.
# If it ever leaks, rotate it: minting/revocation dies with it, but runtime keys
# keep working until `just reap` cleans them up.
OPENROUTER_PROVISIONING_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# INFERENCE
# ─────────────────────────────────────────────────────────────────────────────
#
# Your own runs on this machine. Inside a sandbox this is overwritten during FILL
# with a MINTED key scoped to that run ($50 default, revoked at teardown), so a
# sandbox never sees a key that outlives it.
OPENROUTER_API_KEY=

# Claude Code runs on its own first-party Anthropic key with a workspace spend cap.
# It speaks the Messages API and does not route through OpenRouter cleanly.
# ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Zero data retention
# ─────────────────────────────────────────────────────────────────────────────
#
# Set the data policy ONCE in the OpenRouter dashboard (Settings -> Privacy) rather
# than per request: pi's models.json supports custom headers but no arbitrary request
# body fields, so `provider: {"zdr": true}` cannot be injected through pi's config.
# The account setting covers every key, including minted runtime keys, and Claude Code.
# All nine roster models are verified ZDR-capable.

# ─────────────────────────────────────────────────────────────────────────────
# Optional overrides
# ─────────────────────────────────────────────────────────────────────────────
# ENGINEER_NAME=                   # engineer lane label, defaults to git user.name
# PI_PATH=pi                       # pi binary if not on PATH
# PI_MODELS_PATH=~/.pi/agent/models.json
# SSSF_CONFIG=adws/adw_sssf_config/sssf.config.yaml
